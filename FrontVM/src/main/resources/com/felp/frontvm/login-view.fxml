<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.felp.frontvm.controller.LoginController"
           prefWidth="900" prefHeight="640"
           style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">
    <children>
        <VBox alignment="CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            <children>
                <VBox spacing="18" maxWidth="420" minWidth="420"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 28, 0, 0, 10);">
                    <padding>
                        <Insets top="32" right="32" bottom="32" left="32"/>
                    </padding>
                    <children>
                        <VBox spacing="6" alignment="CENTER">
                            <children>
                                <StackPane fx:id="logoBox" prefWidth="48" prefHeight="48" minWidth="48" minHeight="48"
                                           style="-fx-background-color: #0f172a; -fx-background-radius: 14;"/>
                                <Label text="Bem-vindo ao SimpleVM"
                                       style="-fx-text-fill: #0f172a; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Label fx:id="lblSubtitulo" text="Entre na sua conta"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                            </children>
                        </VBox>

                        <HBox spacing="0" alignment="CENTER"
                              style="-fx-background-color: #f1f5f9; -fx-background-radius: 12;">
                            <padding>
                                <Insets top="4" right="4" bottom="4" left="4"/>
                            </padding>
                            <children>
                                <Button fx:id="btnModoLogin" text="Entrar"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                        onAction="#modoLogin"
                                        style="-fx-cursor: hand; -fx-padding: 8 16; -fx-background-radius: 9; -fx-font-size: 12px;"/>
                                <Button fx:id="btnModoCadastro" text="Cadastrar"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                        onAction="#modoCadastro"
                                        style="-fx-cursor: hand; -fx-padding: 8 16; -fx-background-radius: 9; -fx-font-size: 12px;"/>
                            </children>
                        </HBox>

                        <VBox fx:id="grpNome" spacing="6" managed="false" visible="false">
                            <children>
                                <Label text="Nome"
                                       style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtNome" promptText="Seu nome"
                                           style="-fx-background-color: #ffffff; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 14; -fx-font-size: 13px;"/>
                            </children>
                        </VBox>

                        <VBox spacing="6">
                            <children>
                                <Label text="E-mail"
                                       style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <TextField fx:id="txtEmail" promptText="exemplo@email.com"
                                           style="-fx-background-color: #ffffff; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 14; -fx-font-size: 13px;"/>
                            </children>
                        </VBox>

                        <VBox spacing="6">
                            <children>
                                <Label text="Senha"
                                       style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <PasswordField fx:id="txtSenha" promptText="••••••••"
                                               style="-fx-background-color: #ffffff; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 14; -fx-font-size: 13px;"/>
                            </children>
                        </VBox>

                        <VBox fx:id="grpConfirmar" spacing="6" managed="false" visible="false">
                            <children>
                                <Label text="Confirmar senha"
                                       style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <PasswordField fx:id="txtConfirmar" promptText="••••••••"
                                               style="-fx-background-color: #ffffff; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 14; -fx-font-size: 13px;"/>
                            </children>
                        </VBox>

                        <Label fx:id="lblErro" wrapText="true" managed="false" visible="false"
                               style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>

                        <Button fx:id="btnSubmit" text="Entrar" onAction="#submit"
                                maxWidth="Infinity"
                                style="-fx-background-color: #0f172a; -fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 12; -fx-cursor: hand;"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
