<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.felp.frontvm.controller.PlansController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #ffffff; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="16" right="32" bottom="16" left="32"/>
            </padding>
            <children>
                <StackPane fx:id="logoBox" prefWidth="40" prefHeight="40" minWidth="40" minHeight="40"
                           style="-fx-background-color: #0f172a; -fx-background-radius: 12;"/>
                <VBox spacing="2">
                    <children>
                        <Label fx:id="lblSaudacao" text="Olá"
                               style="-fx-text-fill: #0f172a; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblPlanoAtual" text="Plano atual: —"
                               style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnIrVms" text="Minhas VMs" onAction="#irParaVms"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #0f172a; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
                <Button fx:id="btnSair" text="Sair" onAction="#sair"
                        style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 12; -fx-cursor: hand;"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="8">
            <padding>
                <Insets top="40" right="32" bottom="32" left="32"/>
            </padding>
            <children>
                <Label text="Escolha seu plano"
                       style="-fx-text-fill: #0f172a; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Escolha o plano ideal para você"
                       style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                <HBox fx:id="containerPlanos" spacing="20" alignment="CENTER">
                    <padding>
                        <Insets top="32" right="0" bottom="0" left="0"/>
                    </padding>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
