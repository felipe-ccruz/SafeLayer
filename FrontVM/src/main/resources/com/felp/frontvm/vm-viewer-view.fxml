<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.felp.frontvm.controller.VmViewerController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #020617;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #0f172a; -fx-border-color: transparent transparent #1e293b transparent; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <children>
                <Circle fx:id="statusDot" radius="4"/>
                <Label fx:id="lblNome" text="VM"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 14px;"/>
                <Label fx:id="lblOs" text="·"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnTerminal" text="Abrir terminal" onAction="#abrirTerminal"
                        managed="false" visible="false"
                        style="-fx-background-color: rgba(56,189,248,0.18); -fx-text-fill: #7dd3fc; -fx-font-size: 13px; -fx-padding: 6 12 6 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnPower" onAction="#handlePower"
                        contentDisplay="LEFT" graphicTextGap="8"
                        style="-fx-font-size: 13px; -fx-padding: 6 12 6 12; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnFechar" onAction="#handleFechar"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 6;"/>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane>
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>
            <children>
                <StackPane fx:id="screen"
                           style="-fx-background-color: #0f172a; -fx-background-radius: 16;"
                           prefWidth="900" prefHeight="540"
                           maxWidth="900" maxHeight="540"/>
            </children>
        </StackPane>
    </center>
</BorderPane>
